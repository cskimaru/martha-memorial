# ---- Site ----
SITE_DOMAIN=martha.example.com          # the public domain, DNS A record pointing at the server
ACME_EMAIL=you@example.com              # Let's Encrypt contact for certificate notices
LOG_LEVEL=INFO

# ---- Private preview before launch ----
# true: the whole site asks for a password (user "family", password in secrets/preview_password)
# and shows a colour switcher. Set to false and run `make init && make up` to launch publicly.
SITE_PREVIEW=true

# ---- Permanent address when sharing from this computer (docs/share-from-your-computer.md) ----
# Leave empty for a free random https://….trycloudflare.com link.
PUBLIC_HOSTNAME=
CLOUDFLARE_TUNNEL_TOKEN=

# ---- Images (set by CI/CD; leave as-is to build locally) ----
REGISTRY=ghcr.io/owner/martha-memorial
IMAGE_TAG=latest

# ---- Content ----
MODERATE_PUBLIC_TRIBUTES=true           # visitors' tributes wait for family approval

# ---- Photo storage: local (a disk volume on this server) or s3 (managed object storage) ----
STORAGE_BACKEND=local
S3_ENDPOINT=
S3_BUCKET=memorial-media
S3_REGION=us-east-1
S3_ACCESS_KEY=                          # the secret key goes in secrets/s3_secret_key

# ---- Alerts (email) ----
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
SMTP_HOST=smtp.gmail.com:587
SMTP_USERNAME=

# ---- Backups ----
BACKUP_DIR=./backups
BACKUP_HOUR_UTC=0                       # 03:00 in Nairobi
BACKUP_KEEP_DAYS=30
OFFSITE_S3_ENDPOINT=                    # e.g. https://s3.eu-west-1.amazonaws.com or a Backblaze B2 S3 endpoint
OFFSITE_S3_BUCKET=
OFFSITE_REMOTE=                         # e.g. pcloud:Martha Memorial (set by `make connect-pcloud`)
OFFSITE_KEEP_DAYS=90                    # encrypted backups older than this are removed from OFFSITE_REMOTE
