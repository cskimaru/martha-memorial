# Rendered to deploy/generated/alertmanager.yml by scripts/init.sh from .env
route:
  receiver: family-ops
  group_by: [alertname]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    - matchers: [severity="critical"]
      receiver: family-ops
      repeat_interval: 1h

receivers:
  - name: family-ops
    email_configs:
      - to: "${ALERT_EMAIL_TO}"
        from: "${ALERT_EMAIL_FROM}"
        smarthost: "${SMTP_HOST}"
        auth_username: "${SMTP_USERNAME}"
        auth_password_file: /run/secrets/smtp_password
        require_tls: true
        send_resolved: true
