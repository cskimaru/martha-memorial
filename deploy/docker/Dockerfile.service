# syntax=docker/dockerfile:1.7
# One image recipe for every Python service:  docker build --build-arg SERVICE=auth -f deploy/docker/Dockerfile.service .
ARG PYTHON_IMAGE=python:3.12.10-slim-bookworm

FROM ${PYTHON_IMAGE} AS build
ARG SERVICE
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
RUN python -m venv /venv
COPY libs/common /build/common
COPY services/${SERVICE}/requirements.txt /build/requirements.txt
# An optional CA certificate (build secret "build_ca") lets builds work behind a TLS-inspecting proxy.
RUN --mount=type=secret,id=build_ca,required=false \
    if [ -f /run/secrets/build_ca ]; then export PIP_CERT=/run/secrets/build_ca; fi; \
    /venv/bin/pip install /build/common -r /build/requirements.txt

FROM ${PYTHON_IMAGE}
ARG SERVICE
ARG VERSION=dev
LABEL org.opencontainers.image.title="martha-memorial-${SERVICE}" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.source="https://github.com/OWNER/martha-memorial"
RUN --mount=type=secret,id=build_ca,required=false \
    if [ -f /run/secrets/build_ca ]; then cp /run/secrets/build_ca /usr/local/share/ca-certificates/build_ca.crt && update-ca-certificates >/dev/null; fi; \
    sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources; \
    apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/* \
 && rm -f /usr/local/share/ca-certificates/build_ca.crt && update-ca-certificates --fresh >/dev/null \
 && groupadd --system --gid 10001 app && useradd --system --uid 10001 --gid app --no-create-home app \
 && mkdir -p /data/media && chown -R 10001:10001 /data
COPY --from=build /venv /venv
WORKDIR /srv
COPY --chown=root:root services/${SERVICE}/ /srv/
RUN rm -rf /srv/tests && chmod 0555 /srv/entrypoint.sh
ENV PATH=/venv/bin:$PATH PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 APP_VERSION=${VERSION}
USER 10001:10001
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=4s --start-period=30s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/healthz', timeout=3)" || exit 1
CMD ["/srv/entrypoint.sh"]
